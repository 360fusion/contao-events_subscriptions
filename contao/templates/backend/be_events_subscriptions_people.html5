<?php $f = $this->filters; $e = static fn ($v) => \Contao\StringUtil::specialchars((string) $v); $L = $GLOBALS['TL_LANG']['tl_calendar']; ?>

<div id="tl_buttons">
    <a href="<?= \Contao\StringUtil::ampersand($this->backUrl) ?>" class="header_back" title="<?= $e($GLOBALS['TL_LANG']['MSC']['backBTTitle']) ?>"><?= $GLOBALS['TL_LANG']['MSC']['backBT'] ?></a>
    <?php if ($this->exportUrl): ?><a href="<?= $e($this->exportUrl) ?>" class="header_theme_import"><?= $L['subscriptions_export'][0] ?? 'Export' ?></a><?php endif; ?>
</div>

<div class="maintenance_active">
    <h2 class="sub_headline"><?= $this->headline ?></h2>

    <form id="subscribers-filter" autocomplete="off" action="<?= $e($this->filterAction) ?>" method="get" class="tl_tbox" style="padding:12px 18px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end">
        <?php foreach ($this->filterHidden as $name => $value): ?>
            <input type="hidden" name="<?= $e($name) ?>" value="<?= $e($value) ?>">
        <?php endforeach; ?>
        <?php if ($this->calendarOptions): ?>
            <label style="flex:2 1 220px"><?= $L['subscriptions_upcoming.calendar'] ?><br>
                <select name="calendar" class="tl_select"><option value="">-</option><?php foreach ($this->calendarOptions as $option): ?><option value="<?= $option['id'] ?>"<?= $f['calendar'] === (int) $option['id'] ? ' selected' : '' ?>><?= $e($option['title']) ?></option><?php endforeach; ?></select>
            </label>
        <?php endif; ?>
        <?php if ($this->eventGroupOptions): ?>
            <label style="flex:2 1 220px"><?= $L['subscriptions_upcoming.eventGroup'] ?><br>
                <select name="eventGroup" class="tl_select"><option value="">-</option><?php foreach ($this->eventGroupOptions as $calendarTitle => $groups): ?><optgroup label="<?= $e($calendarTitle) ?>"><?php foreach ($groups as $id => $title): ?><option value="<?= $id ?>"<?= $f['eventGroup'] === $id ? ' selected' : '' ?>><?= $e($title) ?></option><?php endforeach; ?></optgroup><?php endforeach; ?></select>
            </label>
        <?php endif; ?>
        <label style="flex:1 1 140px"><?= $L['subscriptions_upcoming.when'] ?><br>
            <select name="when" class="tl_select">
                <option value=""><?= $L['subscriptions_upcoming.whenAll'] ?></option>
                <option value="upcoming"<?= 'upcoming' === $f['when'] ? ' selected' : '' ?>><?= $L['subscriptions_upcoming.whenUpcoming'] ?></option>
                <option value="past"<?= 'past' === $f['when'] ? ' selected' : '' ?>><?= $L['subscriptions_upcoming.whenPast'] ?></option>
            </select>
        </label>
        <?php if ($this->attendance): ?>
        <label style="flex:1 1 140px"><?= $L['subscribers.attended'] ?><br>
            <select name="attended" class="tl_select">
                <option value="">-</option>
                <option value="yes"<?= 'yes' === $f['attended'] ? ' selected' : '' ?>><?= $GLOBALS['TL_LANG']['MSC']['yes'] ?></option>
                <option value="no"<?= 'no' === $f['attended'] ? ' selected' : '' ?>><?= $GLOBALS['TL_LANG']['MSC']['no'] ?></option>
            </select>
        </label>
        <?php endif; ?>
        <?php if ($this->paymentOptions): ?>
            <label style="flex:1 1 160px"><?= $L['subscribers.payment'] ?><br>
                <select name="payment" class="tl_select"><option value="">-</option><?php foreach ($this->paymentOptions as $status): ?><option value="<?= $e($status) ?>"<?= $f['payment'] === $status ? ' selected' : '' ?>><?= $GLOBALS['TL_LANG']['MSC']['events_subscriptions.paymentStatus'][$status] ?? $e($status) ?></option><?php endforeach; ?></select>
            </label>
        <?php endif; ?>
        <span style="display:flex;gap:6px">
            <button type="submit" class="tl_submit"><?= $L['subscriptions_upcoming.apply'] ?></button>
            <a href="<?= $e($this->filterAction.'?'.http_build_query($this->filterHidden)) ?>" class="tl_submit"><?= $L['subscriptions_upcoming.reset'] ?></a>
        </span>
        <div style="flex:1 1 100%">
            <label style="display:block;max-width:640px">
                <strong><?= $L['subscriptions_upcoming.dynamicSearch'] ?></strong>
                <input type="search" name="search" value="<?= $e($f['search']) ?>" class="tl_text" placeholder="<?= $e($L['subscribers.searchPlaceholder']) ?>" style="height:46px;font-size:1.15em;padding:0 14px;margin-top:6px;width:100%">
                <span class="tl_help tl_tip" style="display:block"><?= $L['subscribers.searchHelp'] ?></span>
            </label>
        </div>
    </form>
    <script>
        // Update the results while typing, keeping the focus in the filter form
        (() => {
            const form = document.getElementById('subscribers-filter');
            let timer, request;

            const update = () => {
                const url = new URL(form.action, location.href);
                new FormData(form).forEach((value, key) => url.searchParams.set(key, value));
                request?.abort();
                request = new AbortController();

                fetch(url, {signal: request.signal, credentials: 'same-origin'})
                    .then(response => response.text())
                    .then(html => {
                        const fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('subscribers-results');
                        document.getElementById('subscribers-results')?.replaceWith(fresh);
                        history.replaceState(null, '', url);
                    })
                    .catch(() => {});
            };

            form.addEventListener('input', event => {
                clearTimeout(timer);
                timer = setTimeout(update, 'SELECT' === event.target.tagName ? 0 : 300);
            });
        })();
    </script>

    <div id="subscribers-results" class="tl_tbox" style="padding:12px 18px;">
        <p class="tl_info" style="margin:0 0 12px"><?= $this->summary ?></p>

        <?php if ($this->rows): ?>
            <table class="tl_listing showColumns">
                <thead>
                <tr>
                    <th class="tl_folder_tlist"><?= $L['subscribers.name'] ?></th>
                    <th class="tl_folder_tlist"><?= $L['subscribers.event'] ?></th>
                    <th class="tl_folder_tlist"><?= $L['subscribers.bookedOn'] ?></th>
                    <th class="tl_folder_tlist"><?= $L['subscribers.status'] ?></th>
                    <?php if ($this->attendance): ?><th class="tl_folder_tlist"><?= $L['subscribers.attended'] ?></th><?php endif; ?>
                    <?php if ($this->paymentOptions): ?><th class="tl_folder_tlist"><?= $L['subscribers.payment'] ?></th><?php endif; ?>
                    <th class="tl_folder_tlist"></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($this->rows as $row): ?>
                    <tr class="hover-row">
                        <td class="tl_file_list" style="min-width:220px;word-break:break-word"><?= $e($row['name']) ?><br><span class="tl_gray"><?= $e($row['email']) ?><?= $row['numberOfParticipants'] > 1 ? ' · '.sprintf($L['subscribers.participants'], $row['numberOfParticipants']) : '' ?></span></td>
                        <td class="tl_file_list"><?= $row['eventTitle'] ?><br><span class="tl_gray"><?= $row['eventDate'] ?><?= $this->showCalendar ? ' · '.$e($row['calendarTitle']) : '' ?></span></td>
                        <td class="tl_file_list" style="white-space:nowrap"><?= $row['booked'] ?></td>
                        <td class="tl_file_list" style="white-space:nowrap"><?= $row['status'] ?></td>
                        <?php if ($this->attendance): ?><td class="tl_file_list" style="white-space:nowrap"><?= $row['attended'] ? $GLOBALS['TL_LANG']['MSC']['yes'] : '-' ?></td><?php endif; ?>
                        <?php if ($this->paymentOptions): ?><td class="tl_file_list" style="white-space:nowrap"><?= $row['payment'] ?: '-' ?></td><?php endif; ?>
                        <td class="tl_file_list tl_right_nowrap">
                            <a href="<?= $e($row['editUrl']) ?>" title="<?= $e($L['subscribers.edit']) ?>"><?= \Contao\Image::getHtml('edit.svg', $L['subscribers.edit']) ?></a>
                            <a href="<?= $e($row['eventUrl']) ?>" title="<?= $e($L['subscribers.eventSubscriptions']) ?>"><?= \Contao\Image::getHtml('mgroup.svg', $L['subscribers.eventSubscriptions']) ?></a>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>

            <?= $this->pagination ?>
        <?php endif; ?>
    </div>
</div>
