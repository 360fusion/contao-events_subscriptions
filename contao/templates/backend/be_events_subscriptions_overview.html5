
<div id="tl_buttons">
    <a href="<?= \Contao\StringUtil::ampersand($this->backUrl) ?>" class="header_back" title="<?= \Contao\StringUtil::specialchars($GLOBALS['TL_LANG']['MSC']['backBTTitle']) ?>"><?= $GLOBALS['TL_LANG']['MSC']['backBT'] ?></a>
</div>

<div class="maintenance_active">
    <h2 class="sub_headline"><?= $this->headline ?: sprintf($GLOBALS['TL_LANG']['tl_calendar']['subscriptions_overview.headline'], $this->calendar) ?></h2>

    <?php if (isset($this->filters)): ?>
        <?php $f = $this->filters; $e = static fn ($v) => \Contao\StringUtil::specialchars((string) $v); $L = $GLOBALS['TL_LANG']['tl_calendar']; $dateFormat = \Contao\Date::getInputFormat(\Contao\Date::getNumericDateFormat()); ?>
        <form id="subscriptions-upcoming-filter" autocomplete="off" action="<?= $e($this->filterAction) ?>" method="get" class="tl_tbox" style="padding:12px 18px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end">
            <?php foreach ($this->filterHidden as $name => $value): ?>
                <input type="hidden" name="<?= $e($name) ?>" value="<?= $e($value) ?>">
            <?php endforeach; ?>
            <label style="flex:2 1 220px"><?= $L['subscriptions_upcoming.search'] ?><br><input type="search" name="search" value="<?= $e($f['search']) ?>" class="tl_text"></label>
            <label style="flex:2 1 220px"><?= $L['subscriptions_upcoming.calendar'] ?><br>
                <select name="calendar" class="tl_select"><option value="">-</option><?php foreach ($this->calendarOptions as $id => $title): ?><option value="<?= $id ?>"<?= $f['calendar'] === $id ? ' selected' : '' ?>><?= $e($title) ?></option><?php endforeach; ?></select>
            </label>
            <?php if ($this->groupOptions): ?>
                <label style="flex:1 1 160px"><?= $L['subscriptions_upcoming.group'] ?><br>
                    <select name="group" class="tl_select"><option value="">-</option><?php foreach ($this->groupOptions as $id => $title): ?><option value="<?= $id ?>"<?= $f['group'] === $id ? ' selected' : '' ?>><?= $e($title) ?></option><?php endforeach; ?></select>
                </label>
            <?php endif; ?>
            <label style="flex:1 1 120px"><?= $L['subscriptions_upcoming.from'] ?><br><input type="text" name="from" value="<?= $e($f['from']) ?>" placeholder="<?= $e($dateFormat) ?>" class="tl_text"></label>
            <label style="flex:1 1 120px"><?= $L['subscriptions_upcoming.to'] ?><br><input type="text" name="to" value="<?= $e($f['to']) ?>" placeholder="<?= $e($dateFormat) ?>" class="tl_text"></label>
            <label style="flex:1 1 140px"><?= $L['subscriptions_upcoming.places'] ?><br>
                <select name="places" class="tl_select">
                    <option value=""><?= $L['subscriptions_upcoming.placesAll'] ?></option>
                    <option value="available"<?= 'available' === $f['places'] ? ' selected' : '' ?>><?= $L['subscriptions_upcoming.placesAvailable'] ?></option>
                    <option value="full"<?= 'full' === $f['places'] ? ' selected' : '' ?>><?= $L['subscriptions_upcoming.placesFull'] ?></option>
                </select>
            </label>
            <span style="display:flex;gap:6px">
                <button type="submit" class="tl_submit"><?= $L['subscriptions_upcoming.apply'] ?></button>
                <a href="<?= $e($this->filterAction.'?'.http_build_query($this->filterHidden)) ?>" class="tl_submit"><?= $L['subscriptions_upcoming.reset'] ?></a>
            </span>
        </form>
        <script>
            // Update the results while typing, keeping the focus in the filter form
            (() => {
                const form = document.getElementById('subscriptions-upcoming-filter');
                let timer, request;

                const update = () => {
                    const url = new URL(form.action, location.href);
                    new FormData(form).forEach((value, key) => url.searchParams.set(key, value));
                    request?.abort();
                    request = new AbortController();

                    fetch(url, {signal: request.signal, credentials: 'same-origin'})
                        .then(response => response.text())
                        .then(html => {
                            const fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('subscriptions-upcoming-results');
                            document.getElementById('subscriptions-upcoming-results')?.replaceWith(fresh);
                            history.replaceState(null, '', url);
                        })
                        .catch(() => {});
                };

                form.addEventListener('input', event => {
                    clearTimeout(timer);
                    timer = setTimeout(update, 'SELECT' === event.target.tagName ? 0 : 300);
                });
            })();
        </script>
    <?php endif; ?>

    <div id="subscriptions-upcoming-results" class="tl_tbox" style="padding:12px 18px;">
        <?php if (isset($this->summary)): ?>
            <p class="tl_info"><?= $this->summary ?></p>
        <?php endif; ?>

        <?php if ($this->entries): ?>
            <table class="tl_listing">
                <thead>
                <tr>
                    <th class="tl_folder_tlist" style="white-space:nowrap"><?= $GLOBALS['TL_LANG']['tl_calendar_events']['startDate'][0] ?></th>
                    <th class="tl_folder_tlist"><?= $GLOBALS['TL_LANG']['tl_calendar_events']['title'][0] ?></th>
                    <th class="tl_folder_tlist"><?= $GLOBALS['TL_LANG']['tl_calendar_events']['subscriptions'][0] ?></th>
                    <th class="tl_folder_tlist"><?= $GLOBALS['TL_LANG']['tl_calendar']['subscriptions_overview.waitingList'] ?></th>
                    <th class="tl_folder_tlist" style="width:1%;white-space:nowrap">&nbsp;</th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($this->entries as $group): ?>
                <tr>
                    <th class="tl_folder_tlist" colspan="5"><?= $group['label'] ?></th>
                </tr>
                <?php foreach ($group['events'] as $event): ?>
                <tr class="hover-div">
                    <td class="tl_file_list" style="background:none;white-space:nowrap"><?= $event['date'] ?></td>
                    <td class="tl_file_list" style="background:none"><?= $event['title'] ?><?php if ($this->showCalendar): ?><br><span class="tl_gray"><?= $event['calendar'] ?></span><?php endif; ?></td>
                    <td class="tl_file_list" style="background:none"><?= $event['subscriptions'] ?> / <?= $event['maxSubscriptions'] ?: '∞' ?></td>
                    <td class="tl_file_list" style="background:none">
                        <?php if ($event['waitingList']): ?>
                            <span><?= $event['waitingListSubscriptions'] ?> / <?= $event['waitingListLimit'] ?: '∞' ?></span>
                        <?php else: ?>
                            <span>-</span>
                        <?php endif; ?>
                    </td>
                    <td class="tl_file_list" style="background:none;width:1%;white-space:nowrap">
                        <a href="<?= \Contao\StringUtil::ampersand($event['editUrl']) ?>" title="<?= \Contao\StringUtil::specialchars(sprintf($GLOBALS['TL_LANG']['tl_calendar_events']['edit'][1], $event['id'])) ?>"><?= \Contao\Image::getHtml('edit.gif') ?></a>
                        <a href="<?= \Contao\StringUtil::ampersand($event['notificationsUrl']) ?>" title="<?= \Contao\StringUtil::specialchars(sprintf($GLOBALS['TL_LANG']['tl_calendar_events']['sendNotifications'][1], $event['id'])) ?>"><?= \Contao\Image::getHtml('system/modules/events_subscriptions/assets/send.svg') ?></a>
                        <a href="<?= \Contao\StringUtil::ampersand($event['url']) ?>" title="<?= \Contao\StringUtil::specialchars(sprintf($GLOBALS['TL_LANG']['tl_calendar_events']['subscriptions'][1], $event['id'])) ?>"><?= \Contao\Image::getHtml('mgroup.gif') ?></a>
                    </td>
                </tr>
                <?php endforeach; ?>
                <?php endforeach; ?>
                </tbody>
            </table>

            <?= $this->pagination ?>
        <?php else: ?>
            <div class="tl_message">
                <p class="tl_info"><?= $GLOBALS['TL_LANG']['tl_calendar']['subscriptions_overview.empty'] ?></p>
            </div>
        <?php endif; ?>
    </div>
</div>
