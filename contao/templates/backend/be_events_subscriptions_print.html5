<?php $L = $GLOBALS['TL_LANG']['tl_calendar']; $e = static fn ($v) => \Contao\StringUtil::specialchars((string) $v); ?>
<!DOCTYPE html>
<html lang="<?= $e($GLOBALS['TL_LANGUAGE'] ?? 'en') ?>">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <title><?= $e($this->title) ?></title>
    <style>
        body{font:13px/1.4 system-ui,-apple-system,"Segoe UI",Arial,sans-serif;color:#111;margin:24px}
        h1{font-size:19px;margin:0 0 4px}.meta{color:#444;margin:0 0 14px}.meta span{display:block}
        table{border-collapse:collapse;width:100%}th,td{border:1px solid #999;padding:5px 7px;text-align:left;vertical-align:top}th{background:#eee}
        td.num,td:first-child{white-space:nowrap}td.num{text-align:right}tr{break-inside:avoid}thead{display:table-header-group}
        .bar{margin:0 0 16px;display:flex;gap:14px;align-items:center}button{font:inherit;padding:6px 14px}.help{color:#555}
        @media print{.bar{display:none}body{margin:0}@page{size:A4 <?= $this->landscape ? 'landscape' : 'portrait' ?>;margin:12mm}}
    </style>
</head>
<body>
<div class="bar">
    <button type="button" onclick="window.print()"><?= $L['export.print'] ?></button>
    <span class="help"><?= $L['export.printHelp'] ?></span>
</div>
<h1><?= $e($this->title) ?></h1>
<p class="meta"><?php foreach ($this->meta as $line): ?><span><?= $e($line) ?></span><?php endforeach; ?></p>
<table>
    <thead><tr><?php foreach ($this->header as $label): ?><th><?= $e($label) ?></th><?php endforeach; ?></tr></thead>
    <tbody>
    <?php foreach ($this->rows as $row): ?>
        <tr><?php foreach ($row as $value): ?><td<?= is_int($value) || is_float($value) ? ' class="num"' : '' ?>><?= $e($value) ?></td><?php endforeach; ?></tr>
    <?php endforeach; ?>
    </tbody>
</table>
</body>
</html>
